# Allow only reviewed publication inputs. Local originals and documents stay local.
/*
!/.gitignore
!/.github/
!/*.html
!/*.css
!/*.js
!/notice.json
/rates-data.november.pending.js
!/assets/
/assets/*
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/pretendard/
/assets/fonts/pretendard/*
!/assets/fonts/pretendard/PretendardVariable.woff2
!/assets/fonts/pretendard/LICENSE.txt
!/assets/fonts/pretendard/README.md
!/scripts/
/scripts/*
!/scripts/prepare-pages.cjs
!/scripts/check-rates.cjs
!/scripts/check-management.cjs
!/scripts/check-rate-scroll.cjs
!/scripts/check-rate-export.cjs
!/scripts/check-rate-export-ui.cjs
!/scripts/check-rate-upload.cjs
!/scripts/check-notice-publish.cjs
!/scripts/check-notice-ui.cjs
!/scripts/fixtures/
/scripts/fixtures/*
!/scripts/fixtures/rates-july.js
!/scripts/fixtures/approved-november-order.json
!/DEPLOYMENT.md

# Never commit credentials, even in allowed directories.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
node_modules/
